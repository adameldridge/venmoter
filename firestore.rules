rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /venues/{venueId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    match /promoters/{promoterId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    match /venue-promoters/{relationshipId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
  }
}